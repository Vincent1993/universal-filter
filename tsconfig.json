{
  "extends": "@monorepo/ts-config/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@hooks/*": ["src/hooks/*"],
      "@contexts/*": ["src/contexts/*"],
      "@core/*": ["src/core/*"],
      "@adapters/*": ["src/adapters/*"],
      "@plugins/*": ["src/plugins/*"]
    }
  },
  "include": ["src", "__tests__", "vitest.config.ts"],
  "exclude": ["dist", "node_modules"]
}
