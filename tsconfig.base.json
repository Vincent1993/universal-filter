{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "paths": {
      "@dfx/universal-filter": ["packages/universal-filter/src/index.ts"],
      "@dfx/dynamic-filter": ["packages/dynamic-filter/src/index.ts"]
    }
  }
}
